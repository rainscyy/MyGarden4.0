# Claude runs only on the server. Never use NEXT_PUBLIC_ for a secret.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
# File storage works without Railway or MongoDB.
GARDEN_STORAGE=file
# Optional: remove GARDEN_STORAGE=file to use a separate MongoDB database.
MONGODB_URI=
GARDEN_MONGODB_DB=our_cognitive_gardens
# For a shared hosted deployment, set a stable random session secret.
GARDEN_SESSION_SECRET=
# Classroom hosting uses /api/cognitive; disable the earlier platform's API.
GARDEN_DISABLE_LEGACY_API=true

# Production always requires signed invitations; set false to test invitations locally.
GARDEN_ALLOW_DEMO_SESSIONS=true
# For hosted file storage, mount a persistent Railway volume and set:
# GARDEN_STATE_PATH=/data/garden/state.json
