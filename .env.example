# Claude runs only on the server. Never use NEXT_PUBLIC_ for a secret.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
# File storage works without Railway or MongoDB.
GARDEN_STORAGE=file
# Optional: remove GARDEN_STORAGE=file to use a separate MongoDB database.
MONGODB_URI=
GARDEN_MONGODB_DB=our_cognitive_gardens
# For a shared hosted deployment, set a stable random session secret.
GARDEN_SESSION_SECRET=
# Classroom hosting uses /api/cognitive; disable the earlier platform's API.
GARDEN_DISABLE_LEGACY_API=true

# Production requires GitHub sign-in or a signed invitation; set false to test hosted access locally.
GARDEN_ALLOW_DEMO_SESSIONS=true
# For hosted file storage, mount a persistent Railway volume and set:
# GARDEN_STATE_PATH=/data/garden/state.json

# Self-service GitHub sign-in (server-only OAuth app credentials).
# Callback: https://our-cognitive-gardens.vercel.app/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GARDEN_PUBLIC_URL=https://our-cognitive-gardens.vercel.app

# Optional server-side tracing (never use NEXT_PUBLIC_ for these keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACING_ENABLED=true
